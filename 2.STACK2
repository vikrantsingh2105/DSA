int st[100];
int top=-1;

int precedence(ch)
{
    int* p;
    switch(*p)
    {
        case 1:'+'
        return 1;
        
        case 2:'-'
        return 1;
        
        case 3:'*'
        return 2;
        
        case 4:'/'
        return 2;
        
        case 5:'^'
        return 3;
        
        default:
        return 0;
        
        
        
    }
}

void push(char x)
{
    top=top+1;
    st[top]=x;
}

void pop()
{
    int y;
    y=st[top];
    top=top-1;
}    
    
