# include <stdio.h>

int push(int);
int pop();
int peek();
int traverse();
int top=-1;
int st[4];

int main()
{
    push(9);
    push(10);
    push(8);
    push(7);
    pop();
    push(1);
    peek();
    traverse();

    return 0;
}

int push(int x)
{
    if(top==3)
    {
        printf("stack is full\n");
    }
    else
    {
        top=top+1;
        st[top]=x;
    }
    return 0;
}

int pop()
{
    if(top==-1)
    {
        printf("stack is already empty");
    }
    else
    {
        int y;
        y=st[top];
        top=top-1;
    }
    return 0;
}

int peek()
{
    int y;
    y=st[top];
    printf("The value at top is %d\n",y);
    return 0;
}

int traverse()
{
    if(top==-1)
    {
        printf("empty is empty");
    }
    else 
    {
        printf("Stack elements =");
        for(int i=top;i>=0;i--)
        {
            printf("%d\n",st[i]);
        }
        printf("\n");
    }
    return 0;
}
